# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Python virtual environment
.venv/
venv/
ENV/

# OS files
.DS_Store
Thumbs.db

# Ignore all png files by default
*.png
# Allow png templates
!templates/**/*.png
!templates/*.png

# Allow images in documentation stories
!docs/storys/**/*.png
!docs/storys/**/*.jpg
!docs/storys/**/*.jpeg
!docs/storys/**/*.gif


# Test coverage outputs
.coverage
htmlcov/

# Project-specific debug and grid verification screenshots
debug_click.png
debug_grid_test.png
debug_*_dim_*.png
debug_analyze_*.png

# Development drafts and temporary scratch files (entire directory)
scratch/

# User runtime data & state persistence
user_data/
user_data_test_temp/
config/local.toml
/meta_datas.tres
!meta_data/raw_tres/meta_datas.tres

tools/x64dbg
tools/gdre
